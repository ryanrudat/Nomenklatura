import Foundation

/// API configuration - thread-safe constants accessible from any actor
enum Secrets: Sendable {
    // MARK: - Production (Proxy)

    /// Your Railway proxy URL - set this after deploying the proxy
    static let proxyURL = "https://YOUR-RAILWAY-APP.up.railway.app/api/messages"

    /// Set to false to use the proxy (production), true for direct API access (local dev)
    static let useDirectAPI = true

    /// Shared secret sent as x-proxy-token on every proxy request. Must match
    /// the PROXY_AUTH_TOKEN env var on the Railway service (generate one with
    /// `openssl rand -hex 24`). Abuse prevention, not cryptographic security.
    static let proxyAuthToken = "YOUR_PROXY_TOKEN_HERE"

    // MARK: - Development (Direct API)

    /// Your Anthropic API key - only used when useDirectAPI = true
    static let anthropicAPIKey = "YOUR_API_KEY_HERE"

    /// Whether AI features are enabled
    static let isAIEnabled: Bool = {
        if useDirectAPI {
            return anthropicAPIKey != "YOUR_API_KEY_HERE" && !anthropicAPIKey.isEmpty
        } else {
            return proxyURL != "https://YOUR-RAILWAY-APP.up.railway.app/api/messages"
        }
    }()
}
